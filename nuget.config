<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Filled by repro.sh from repro/package-sources. -->
    <add key="repro" value="repro/feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="repro">
      <package pattern="RazorCacheRepro.Widgets" />
    </packageSource>
  </packageSourceMapping>
</configuration>
