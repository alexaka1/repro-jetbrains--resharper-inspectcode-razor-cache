<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="RazorCacheRepro.Widgets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RazorCacheRepro.Api\RazorCacheRepro.Api.csproj" />
    <ProjectReference Include="..\RazorCacheRepro.Components\RazorCacheRepro.Components.csproj" />
  </ItemGroup>

</Project>
